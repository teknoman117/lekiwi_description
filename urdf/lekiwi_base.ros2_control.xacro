<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One velocity-mode wheel servo -->
  <xacro:macro name="lekiwi_wheel_ros2_joint" params="name id">
    <joint name="${name}">
      <param name="id">${id}</param>
      <param name="type">vel</param>
      <param name="max_speed">9.2</param>
      <command_interface name="velocity">
        <param name="min">-9.2</param>
        <param name="max">9.2</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature"/>
    </joint>
  </xacro:macro>

  <!-- The base's joints only, for use inside any <ros2_control> block. A combined robot that
       shares the servo bus calls this inside its own single <hardware> block. -->
  <xacro:macro name="lekiwi_base_ros2_joints" params="prefix:=''">
    <xacro:lekiwi_wheel_ros2_joint name="${prefix}left_wheel_joint" id="7"/>
    <xacro:lekiwi_wheel_ros2_joint name="${prefix}rear_wheel_joint" id="8"/>
    <xacro:lekiwi_wheel_ros2_joint name="${prefix}right_wheel_joint" id="9"/>
  </xacro:macro>

  <!-- A standalone ros2_control system for the base on its own bus -->
  <xacro:macro name="lekiwi_base_ros2_control"
               params="name:=lekiwi_base prefix:='' port:=/dev/ttyACM0 baudrate:=1000000 use_mock_hardware:=false">

    <!-- true/false/1/0 in any case; anything else aborts the render -->
    <xacro:property name="mock"
        value="${['false', '0', 'true', '1'].index(str(use_mock_hardware).strip().lower()) >= 2}"/>

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${mock}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${mock}">
          <plugin>waveshare_servos/WaveshareServos</plugin>
          <param name="port">${port}</param>
          <param name="baudrate">${baudrate}</param>
        </xacro:unless>
      </hardware>

      <xacro:lekiwi_base_ros2_joints prefix="${prefix}"/>
    </ros2_control>

  </xacro:macro>

</robot>
